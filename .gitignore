# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Local env
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Local agent/editor scratch
.claude/

# Transient QA capture output. `docs/qa/before`, `docs/qa/after` and
# `docs/qa/polish` are committed on purpose — they are the visual record of what
# is locked. Anything written to `docs/qa/wip` is throwaway.
docs/qa/wip/

# Review packages: these only bundle files that already live in the repo or are
# deliberately ignored, so committing them would duplicate megabytes for nothing.
docs/qa/**/*.zip

# Screen recordings, probe generations and QA composites. The only video the
# site actually ships is the Open & Pour plate, which is a real production
# asset rather than a recording, so it is committed explicitly.
*.mp4
*.mov
*.webm
!public/assets/open-pour/open-pour-final.mp4
